{
  "name": "dsh-plugin-browser",
  "version": "0.5.1",
  "description": "Session-isolated Playwright browser tools for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "browser.js",
    "native.js",
    "client.js",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "browser:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "LGPL-3.0-only",
  "repository": "github:hzxwonder-dsh-plugins/dsh-plugin-browser",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "playwright": "1.61.1"
  }
}
